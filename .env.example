# Salin ke .env lalu sesuaikan. ./prod.sh membaca file ini kalau ada.

# Port di host
APP_PORT=3000
DB_PORT=5440

# Password database. Ganti sebelum menjalankan ./prod.sh pertama kali (lalu sesuaikan
# DATABASE_URL di bawah). Kalau database sudah terlanjur dibuat, ubah juga di dalam database:
#   scripts/db.sh psql  →  ALTER USER scanner PASSWORD 'password-baru';
DB_PASSWORD=scanner

# Update otomatis setiap Senin–Jumat pada jam WIB berikut
INGEST_AT=17:00
INGEST_CONCURRENCY=4
BACKFILL_YEARS=5
CACHE_BARS=300
# Update intraday selama jam bursa (09:00–16:15 WIB) untuk semua saham, 100 saham per request.
# Satu request tiap LIVE_GAP_SECS detik; putaran baru paling cepat tiap LIVE_INTERVAL_MIN menit.
LIVE_UPDATE=1
LIVE_GAP_SECS=3
LIVE_INTERVAL_MIN=2
RUST_LOG=info,sqlx=warn,tower_http=warn

# Hanya untuk menjalankan backend/test langsung di host (di dalam container
# alamat database diatur oleh compose.yaml).
DATABASE_URL=postgres://scanner:scanner@localhost:5440/scanner
